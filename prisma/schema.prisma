generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Program {
  id          String              @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime            @default(now())
  corpusId    String?             @unique // corpus/programs/<id>.json, set by corpus:import
  days        ProgramDay[]
  enrollments ProgramEnrollment[]
}

model ProgramDay {
  id              String           @id @default(cuid())
  programId       String
  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  name            String
  focus           String?
  dayNumber       Int
  totalTime       String?
  sections        Section[]
  workoutSessions WorkoutSession[]
  scheduleEntries ScheduleEntry[]

  @@unique([programId, dayNumber])
}

model Section {
  id           String     @id @default(cuid())
  programDayId String
  programDay   ProgramDay @relation(fields: [programDayId], references: [id], onDelete: Cascade)
  name         String
  type         String
  order        Int
  restSeconds  Int?
  notes        String?
  exercises    Exercise[]

  @@unique([programDayId, order])
}

model Exercise {
  id          String           @id @default(cuid())
  sectionId   String
  section     Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sets        Int
  reps        String
  holdSeconds Int?
  order       Int
  libraryId   String?
  library     LibraryExercise? @relation(fields: [libraryId], references: [id])
  setLogs     SetLog[]

  @@unique([sectionId, order])
}

model Profile {
  id              String              @id @default(cuid())
  name            String
  goal            String? // standing goal in the user's words: "dunk by summer"
  goalFocus       String[]            @default([])
  athlete         Json? // onboarding answers, see src/lib/engine/athlete.ts
  createdAt       DateTime            @default(now())
  workoutSessions WorkoutSession[]
  nutritionTarget NutritionTarget?
  enrollments     ProgramEnrollment[]
  checkIns        CheckIn[]
  mealPlans       MealPlan[]
  mealLogs        MealLog[]
}

model WorkoutSession {
  id           String     @id @default(cuid())
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id])
  programDayId String
  programDay   ProgramDay @relation(fields: [programDayId], references: [id])
  date         DateTime   @default(now())
  startedAt    DateTime   @default(now())
  completedAt  DateTime?
  notes        String?
  setLogs      SetLog[]
}

model WeekSchedule {
  id         String          @id @default(cuid())
  weekNumber Int             @unique
  name       String
  notes      String?
  entries    ScheduleEntry[]
}

model ScheduleEntry {
  id           String       @id @default(cuid())
  scheduleId   String
  schedule     WeekSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 1=Monday ... 7=Sunday
  programDayId String?
  programDay   ProgramDay?  @relation(fields: [programDayId], references: [id])
  isRest       Boolean      @default(false)
  notes        String?
  order        Int          @default(1)

  @@unique([scheduleId, dayOfWeek, order])
}

model SetLog {
  id               String         @id @default(cuid())
  workoutSessionId String
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise       @relation(fields: [exerciseId], references: [id])
  setNumber        Int
  weight           Float?
  reps             Int?
  completed        Boolean        @default(false)
  notes            String?
}

model NutritionTarget {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
}

model Food {
  id                  String         @id @default(cuid())
  name                String         @unique
  brand               String?
  caloriesPer100g     Float
  proteinPer100g      Float
  carbsPer100g        Float
  fatPer100g          Float
  defaultServingGrams Float?
  defaultServingLabel String?
  tags                String[]
  createdAt           DateTime       @default(now())
  mealLogItems        MealLogItem[]
  mealPlanItems       MealPlanItem[]
}

model MealPlan {
  id        String         @id @default(cuid())
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean        @default(false)
  createdAt DateTime       @default(now())
  meals     MealPlanMeal[]

  @@unique([profileId, name])
}

model MealPlanMeal {
  id          String         @id @default(cuid())
  mealPlanId  String
  mealPlan    MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  mealType    String
  title       String
  description String?
  variant     Int            @default(1)
  frequency   String?
  notes       String?
  order       Int
  items       MealPlanItem[]
}

model MealPlanItem {
  id             String       @id @default(cuid())
  mealPlanMealId String
  mealPlanMeal   MealPlanMeal @relation(fields: [mealPlanMealId], references: [id], onDelete: Cascade)
  foodId         String
  food           Food         @relation(fields: [foodId], references: [id])
  gramsMale      Float
  gramsFemale    Float
  notes          String?
  order          Int
}

model MealLog {
  id        String        @id @default(cuid())
  profileId String
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date      DateTime
  mealType  String
  title     String?
  createdAt DateTime      @default(now())
  items     MealLogItem[]

  @@index([profileId, date])
}

model MealLogItem {
  id        String  @id @default(cuid())
  mealLogId String
  mealLog   MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food    @relation(fields: [foodId], references: [id])
  grams     Float
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  order     Int     @default(0)
}

// One row per corpus/library record. `data` holds the full CorpusExercise JSON.
model LibraryExercise {
  id         String     @id // corpus id (kebab-case)
  name       String
  category   String
  sourceKind String
  intensity  Int
  impact     String
  bodyAreas  String[]
  goals      String[]
  data       Json
  updatedAt  DateTime   @updatedAt
  exercises  Exercise[]
}

// A profile following a day-sequenced program (BAT 28-day): day N = days since startDate.
model ProgramEnrollment {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  startDate DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([profileId, programId])
}

// "Here's how I feel" — the parsed inputs and the plan the engine built from them.
model CheckIn {
  id              String   @id @default(cuid())
  profileId       String
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  rawText         String?
  energy          Int
  soreness        Int
  sleep           Int?
  painAreas       String[]
  focus           String[]
  minutes         Int
  outsideActivity Json?
  override        Boolean  @default(false)
  plan            Json
  createdAt       DateTime @default(now())

  @@index([profileId, date])
}
